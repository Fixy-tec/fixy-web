# =====================================================
# Plantilla de variables de entorno del BACKEND.
# Copia este archivo a `.env` para desarrollo local.
# En Render, configura cada variable desde el dashboard
# del servicio (NUNCA subas .env al repo).
# =====================================================

# Conexión a la base de datos PostgreSQL (Neon, Render PG, etc.)
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Secreto para firmar JWTs. En producción usa una cadena larga y aleatoria.
JWT_SECRET=replace-me-with-a-long-random-string

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URLs públicas (cambian entre dev y producción)
# Desarrollo:
#   FRONTEND_URL=http://localhost:3000
#   BACKEND_URL=http://localhost:4000
# Producción:
#   FRONTEND_URL=https://fixy-web.vercel.app
#   BACKEND_URL=https://tu-backend-en-render.onrender.com
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Lista (separada por comas) de orígenes permitidos por CORS. En producción
# pon SOLO los dominios de tu frontend en Vercel, p.ej.:
#   https://fixy-web.vercel.app,https://fixy-web-staging.vercel.app
# En dev puedes incluir además http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render inyecta su propio PORT automáticamente. En local usamos 4000.
PORT=4000

# Credenciales del administrador padre (usar con: npm run seed:admin)
# Debe ser un correo @tecsup.edu.pe — el admin inicia sesión con Google.
ADMIN_EMAIL=admin@tecsup.edu.pe
ADMIN_NAME=Administrador Fixy
