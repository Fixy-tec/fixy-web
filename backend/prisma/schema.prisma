generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()"))
  email                  String                  @unique
  password               String?
  googleId               String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  points                 Int                     @default(0)
  isActive               Boolean                 @default(true)
  medal                  Medal                   @default(HIERRO)
  name                   String
  role                   Role                    @default(USER)
  isRootAdmin            Boolean                 @default(false)
  profileCompleted       Boolean                 @default(false)
  institution            String?                 @default("TECSUP")
  /// El plan es efectivo solo mientras `planExpiresAt` esté en el futuro.
  plan                   PlanType                @default(FREE)
  planExpiresAt          DateTime?
  applications           Application[]           @relation("AppliedBy")
  paymentsMade           Payment[]               @relation("PaymentPayer")
  paymentsReceived       Payment[]               @relation("PaymentPayee")
  paymentsReviewed       Payment[]               @relation("PaymentReviewer")
  adminLogsPerformed     AdminLog[]              @relation("AdminActions")
  adminLogsTargeted      AdminLog[]              @relation("AdminTargets")
  deviceTokens           DeviceToken[]
  notificationRecipients NotificationRecipient[]
  pointLogs              PointLog[]
  profile                Profile?
  ratingsReceived        Rating[]                @relation("ReceivedBy")
  ratingsGiven           Rating[]                @relation("GivenBy")
  requestsCreated        Request[]               @relation("CreatedBy")
  userTags               UserTag[]

  @@index([email])
  @@index([googleId])
  @@index([createdAt])
}

model Profile {
  id           String  @id @default(dbgenerated("gen_random_uuid()"))
  userId       String  @unique
  career       String  @default("Desarrollo de Software")
  cycle        Int?
  whatsapp     String
  avatarUrl    String?
  avgRating    Float   @default(0)
  bio          String?
  institution  String?
  linkedinUrl  String?
  portfolioUrl String?
  githubUrl    String?
  profileViews Int     @default(0)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String       @id @default(dbgenerated("gen_random_uuid()"))
  name      String       @unique
  createdAt DateTime     @default(now())
  isCustom  Boolean      @default(false)
  requests  RequestTag[]
  users     UserTag[]
}

model UserTag {
  userId     String
  tagId      String
  assignedAt DateTime @default(now())
  tag        Tag      @relation(fields: [tagId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, tagId])
}

model RequestTag {
  requestId String
  tagId     String
  request   Request @relation(fields: [requestId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([requestId, tagId])
}

model Request {
  id                 String        @id @default(dbgenerated("gen_random_uuid()"))
  type               RequestType
  title              String
  description        String
  difficulty         Int           @db.SmallInt
  status             RequestStatus @default(ABIERTA)
  createdAt          DateTime      @default(now())
  deadline           DateTime?
  basePoints         Int
  creatorId          String
  economicBenefit    Float?
  participantsNeeded Int           @default(1)
  updatedAt          DateTime      @updatedAt
  isExpired          Boolean       @default(false)
  /// Solicitudes de usuarios Pro: se muestran primero en el feed.
  isFeatured         Boolean       @default(false)
  applications       Application[] @relation("AppliedTo")
  pointLogs          PointLog[]
  creator            User          @relation("CreatedBy", fields: [creatorId], references: [id], onDelete: Cascade)
  tags               RequestTag[]

  @@index([creatorId])
  @@index([isFeatured])
  @@index([status])
  @@index([createdAt])
  @@index([difficulty])
}

model Application {
  id          String            @id @default(dbgenerated("gen_random_uuid()"))
  requestId   String
  message     String
  status      ApplicationStatus @default(PENDIENTE)
  createdAt   DateTime          @default(now())
  applicantId String
  updatedAt   DateTime          @updatedAt
  applicant   User              @relation("AppliedBy", fields: [applicantId], references: [id], onDelete: Cascade)
  request     Request           @relation("AppliedTo", fields: [requestId], references: [id], onDelete: Cascade)
  ratings     Rating[]
  payment     Payment?

  @@unique([requestId, applicantId])
  @@index([requestId])
  @@index([applicantId])
  @@index([status])
  @@index([createdAt])
}

model Rating {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  applicationId   String
  comment         String?
  createdAt       DateTime    @default(now())
  ratedId         String
  raterId         String
  stars           Int         @db.SmallInt
  isAutoGenerated Boolean     @default(false)
  pointLogs       PointLog[]
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rated           User        @relation("ReceivedBy", fields: [ratedId], references: [id], onDelete: Cascade)
  rater           User        @relation("GivenBy", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([applicationId, raterId])
  @@index([raterId])
  @@index([ratedId])
  @@index([createdAt])
}

model PointLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  userId      String
  ratingId    String?
  requestId   String?
  delta       Int
  reason      String
  medalBefore Medal?
  medalAfter  Medal?
  createdAt   DateTime @default(now())
  rating      Rating?  @relation(fields: [ratingId], references: [id])
  request     Request? @relation(fields: [requestId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id         String                  @id @default(uuid())
  type       NotificationType
  data       Json?
  createdAt  DateTime                @default(now())
  message    String
  title      String
  updatedAt  DateTime                @updatedAt
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  notificationId String
  userId         String
  read           Boolean      @default(false)
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@index([read])
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RequestType {
  ASESORIA
  PROYECTO
}

enum RequestStatus {
  ABIERTA
  EN_REVISION
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum ApplicationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  REQUEST_COMPLETED
  NEW_MATCH
  RANK_UP
  PAYMENT_UPDATE
}

enum PlanType {
  FREE
  PRO
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PaymentPurpose {
  PLAN_SUBSCRIPTION
  ASESORIA_ESCROW
}

enum PaymentMethod {
  CARD
  YAPE
}

/// TEST = pasarela simulada (no mueve dinero). LIVE = dinero real verificado por un admin.
enum PaymentMode {
  TEST
  LIVE
}

/// PENDING: Yape esperando verificación del admin.
/// APPROVED: pago de plan acreditado.
/// HELD: pago de asesoría retenido en garantía.
/// RELEASED: garantía liberada al ayudante. REFUNDED: devuelta al pagador.
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  HELD
  RELEASED
  REFUNDED
}

/// Montos en céntimos (Int) para evitar errores de redondeo con decimales.
/// Nunca se guarda el número completo de la tarjeta ni el CVV.
model Payment {
  id              String         @id @default(dbgenerated("gen_random_uuid()"))
  code            String         @unique
  purpose         PaymentPurpose
  method          PaymentMethod
  mode            PaymentMode
  status          PaymentStatus
  amountCents     Int
  commissionCents Int            @default(0)
  payoutCents     Int?
  currency        String         @default("PEN") @db.VarChar(3)
  description     String
  payerId         String
  payeeId         String?
  applicationId   String?        @unique
  planPeriod      BillingPeriod?
  cardBrand       String?
  cardLast4       String?        @db.VarChar(4)
  cardHolder      String?
  yapeOperation   String?
  declineReason   String?
  reviewedById    String?
  reviewedAt      DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  payoutSentAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payer           User           @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee           User?          @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: SetNull)
  reviewedBy      User?          @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  application     Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([purpose])
  @@index([createdAt])
}

enum InvestmentCategory {
  INFRAESTRUCTURA
  MARKETING
  DISENO
  DESARROLLO
  OTROS
}

/// Lo invertido en el negocio (hosting, dominio, publicidad…). Base del ROI.
model Investment {
  id          String             @id @default(dbgenerated("gen_random_uuid()"))
  concept     String
  category    InvestmentCategory @default(OTROS)
  amountCents Int
  spentAt     DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([spentAt])
}

/// Configuración única (id = 1) editable desde el panel admin.
model PaymentSettings {
  id                 Int      @id @default(1)
  proMonthlyCents    Int      @default(990)
  proYearlyCents     Int      @default(8990)
  /// Comisión que la app retiene a ayudantes Free en asesorías pagadas (1000 = 10%).
  freeCommissionBps  Int      @default(1000)
  cardEnabled        Boolean  @default(true)
  yapeEnabled        Boolean  @default(true)
  yapePhone          String?
  yapeHolder         String?
  payoutBank         String?
  payoutHolder       String?
  payoutAccount      String?
  payoutCci          String?
  updatedAt          DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum Medal {
  HIERRO
  BRONCE
  PLATA
  ORO
  DIAMANTE
  MAESTRO
  CHALLENGER
}

model AdminLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  adminId      String
  action       String
  targetUserId String?
  description  String
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("AdminTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}
